<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
        <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
        <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
    </configSections>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
    </startup>
    <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider,Fanex.Data" resourcePath="App_Data" enableWatching="1" />
        </providers>
    </Fanex.Data.DbSettingProvider>
    <Fanex.Logging msmqPath="FormatName:DIRECT=http://10.40.40.73/msmq/Private$/entlib" defaultCategory="Fraud-Detection-Service-UAT" />
    <appSettings>
        <add key="ClientSettingsProvider.ServiceUri" value="" />
        <add key="RemoteRefURL" value="tcp://10.40.40.29:8098/CallGetRefFunction" />
        <add key="RemoteCacheUrl" value="tcp://10.40.40.29:8098/CallGetOddsFunction" />
        <add key="queuePath" value="FormatName:DIRECT=TCP:10.40.40.73\private$\fdmessagequeue"/>
        <add key="FDUrl" value="" />
        <add key="ProPunterChunkSize" value="1000"/>
        <add key="NewVirtualMultiplier" value="1"/>
        <add key="VirtualMultiplierForWinning" value="1"/>
        <add key="VirtualMultiplierForLosing" value="1"/>
        <add key="SiteIds" value="23"/>
        <add key="SuperIds" value=""/>
        <add key="ServiceExecutionInterval" value="1"/>
        <add key="DummyUser" value="862400"/>
        <add key="IP" value=""/>
        <add key="MailingListId" value="100"/>
    </appSettings>
    <connectionStrings>
        <add name="DBDW.bodb_dwrs.bodbAdminNet" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.61;Asynchronous Processing=true;Initial Catalog=bodb_dwrs;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr="/>
        <add name="DBLOG.bodb_CustomerLog.bodbAdminNet" connectionString="Data Source=10.40.40.92;Initial Catalog=bodb_CustomerLog;integrated security=false; User ID=bodbAdminNet;Password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr=" providerName="System.Data.SqlClient" />
        <add name="DBCust.CustDB.bodbAdminNet" connectionString="Data Source=10.40.40.191;Initial Catalog=CustDB;integrated security=false; User ID=bodbAdminNet;Password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr=" providerName="System.Data.SqlClient" />
    </connectionStrings>
    <system.web>
        <membership defaultProvider="ClientAuthenticationMembershipProvider">
            <providers>
                <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
            </providers>
        </membership>
        <roleManager defaultProvider="ClientRoleProvider" enabled="true">
            <providers>
                <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
            </providers>
        </roleManager>
    </system.web>
    <Fanex.MailDelivery.Client environment="PRO"
                               applicationSendMailId="53"
                               siteId="20"
                               rabbitMQConnectionString="host=10.40.40.127;virtualHost=/MailStationHost;username=rabbitclient"
                               messageBrokerLogCategory="MailCentralized">
        <Functions>
            <!--<add id="1" name="YourFunction" />-->
        </Functions>
        <Schedules>
            <!--<Schedule id="2" name="YourSchedule" job="YourProject.Namespace.Job, YourProject">-->
        </Schedules>
    </Fanex.MailDelivery.Client>
    <runtime>
