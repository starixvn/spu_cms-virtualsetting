<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider,Fanex.Data" resourcePath="App_Data" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=http://10.18.200.103:808/msmq/Private$/entlib" defaultCategory="SPU.Local" />
  <log4net>
    <appender name="Fanex.AutoAdjustVR.Service" type="log4net.Appender.RollingFileAppender">
      <file value="Logs\" />
      <datePattern value="'fpslog'-dd.MM.yyyy'.log'" />
      <rollingStyle value="Composite" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="3MB" />
      <staticLogFileName value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level AutoAdjustVR - %message%newline" />
      </layout>
    </appender>
    <logger name="LogService">
      <level value="ALL" />
      <appender-ref ref="Fanex.AutoAdjustVR.Service" />
    </logger>
  </log4net>
  <appSettings>
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="RemoteRefURL" value="tcp://ha.nexdev.net:8888/CallGetRefFunction" />
    <add key="RemoteCacheUrl" value="tcp://10.18.200.124:8888/CallGetOddsFunction" />
    <add key="queuePath" value="FormatName:DIRECT=TCP:10.70.70.242\private$\fdmessagequeue" />
    <add key="FDUrl" value="" />
    <add key="PunterChunkSize" value="1000" />
    <add key="NewVirtualMultiplierForWinning" value="1" />
    <add key="NewVirtualMultiplierForSuperProPunter" value="3" />    
    <add key="VirtualRateThresholdForWinning" value="1" />    
    <!-- in second -->
    <add key="IdleTime" value="30" />
    <add key="SiteIds" value="" />
    <add key="SuperIds" value="" />        
    <add key="JobCronEveryDay" value="0 52 23 * * ?" />    
    <add key="DummyUser" value="862400" />
    <add key="IP" value="" />
    <add key="MailingListId" value="80" />
    <add key="SpecialExecuteDate" value="2017/10/4" />
    <add key="NumOfMonth" value="12" />
  </appSettings>
  <connectionStrings>
    <!--<add name="DBDW.bodb_dwrs.bodbAdminNet" connectionString="packet size=4096; Data Source=10.18.200.231;Asynchronous Processing=true;Initial Catalog=bodb_dwrs;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr=" providerName="System.Data.SqlClient" />-->
    <add name="DBDW.bodb_dwrs.bodbAdminNet" connectionString="packet size=4096; Data Source=10.18.200.215;Asynchronous Processing=true;Initial Catalog=bodb_dwrs;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr=" providerName="System.Data.SqlClient" />
    <add name="DBLOG.bodb_CustomerLog.bodbAdminNet" connectionString="Data Source=10.18.200.215;Initial Catalog=bodb_CustomerLog;integrated security=false; User ID=bodbAdminNet;Password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr=" providerName="System.Data.SqlClient" />
    <add name="DBCust.CustDB.bodbAdminNet" connectionString="Data Source=10.18.200.233;Initial Catalog=CustDB;integrated security=false; User ID=bodbAdminNet;Password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr=" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
  <Fanex.MailDelivery.Client environment="local" applicationSendMailId="1" siteId="95" rabbitMQConnectionString="host=10.35.35.253,10.35.35.254;virtualHost=/QCLocalTest;username=rabbitclient" messageBrokerLogCategory="MailCentralized">
    <Functions>
      <!--<add id="1" name="YourFunction" />-->
    </Functions>
    <Schedules>
      <!--<Schedule id="2" name="YourSchedule" job="YourProject.Namespace.Job, YourProject">-->
    </Schedules>
  </Fanex.MailDelivery.Client>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.6.10.0" newVersion="2.6.10.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.6.10.0" newVersion="2.6.10.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Moq" publicKeyToken="69f491c39445e920" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.1502.911" newVersion="4.2.1502.911" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="NPOI" publicKeyToken="0DF73EC7942B34E1" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.6.0" newVersion="2.0.6.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="RabbitMQ.Client" publicKeyToken="89e7d7c5feba84ce" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.4.0" newVersion="3.5.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Quartz" publicKeyToken="f6b8c98a402cc8a4" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.3.3.0" newVersion="2.3.3.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>